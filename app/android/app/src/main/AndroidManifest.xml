<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      应用内更新：Android 8.0+ 拉起系统安装器必须声明此权限，
      否则安装器会直接拒绝（这是「移动端无法应用内更新」的主因之一）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 读取系统下载目录里的升级包（部分 ROM 的安装器需要） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 规格书 4.4：扫描系统音乐库需要读取音频（Android 13+ 用细分媒体权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
      B 站扫码登录「拉起客户端」：Android 11+ 的包可见性过滤要求显式声明
      要跳转的 scheme，否则 bilibili:// 链接无法解析到哔哩哔哩 App。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bilibili" />
        </intent>
    </queries>

    <!--
      设备形态声明（手机的触摸+竖屏、平板的横屏、车机的 automotive required）
      已按 productFlavor 下沉到 src/{phone,tablet,automotive}/AndroidManifest.xml，
      由各 flavor 独立声明。此处只保留三端共有的权限、组件与 queries。
    -->
</manifest>
