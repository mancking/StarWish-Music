<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      应用内更新：Android 8.0+ 拉起系统安装器必须声明此权限，
      否则安装器会直接拒绝（这是「移动端无法应用内更新」的主因之一）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 读取系统下载目录里的升级包（部分 ROM 的安装器需要） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 规格书 4.4：扫描系统音乐库需要读取音频（Android 13+ 用细分媒体权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
      B 站扫码登录「拉起客户端」：Android 11+ 的包可见性过滤要求显式声明
      要跳转的 scheme，否则 bilibili:// 链接无法解析到哔哩哔哩 App。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bilibili" />
        </intent>
    </queries>

    <!--
      车机端（Android Automotive OS 及国内 Android 车机）兼容声明。
      这两条 required=false 是「允许安装」而非「要求能力」：
      · type.automotive —— 让 AAOS 车机允许安装本应用；
      · touchscreen 不设为必需 —— 部分车机以旋钮/方向盘按键为主要输入，
        默认要求触摸屏会把这些设备挡在安装之外。
      不声明 leanback（电视）与 automotive 必需，手机端与车机端共用同一个 APK。
    -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
</manifest>
