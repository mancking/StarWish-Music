{
  "name": "starwish-music",
  "productName": "星河音乐",
  "version": "2.3.1",
  "description": "星河音乐 StarWish Music —— 多音源聚合桌面音乐播放器（Electron + Vue3 + TypeScript 新架构）",
  "main": "dist/electron/main.js",
  "author": {
    "name": "StarWish Music 开发组",
    "email": "starwish@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win portable nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "test:core": "node scripts/test-core.mjs",
    "test:paths": "node scripts/paths-check.mjs",
    "test:playlists": "node scripts/playlists-check.mjs",
    "test:podcast": "node scripts/podcast-check.mjs",
    "test:order": "node scripts/pl-order-check.mjs",
    "test:pl-source": "node scripts/pl-source-check.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts && node scripts/copy-wasm.mjs && node scripts/rename-mobile-html.mjs",
    "mobile:sync": "npm run build:mobile && cap sync android",
    "dist:android": "npm run build:mobile && cap sync android && cd android && gradlew.bat assembleRelease assembleDebug",
    "mobile:smoke": "electron --no-sandbox scripts/mobile-smoke.mjs"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "axios": "^1.20.0",
    "big-integer": "^1.6.52",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.23",
    "he": "^2.0.0",
    "music-metadata": "^10.9.1",
    "qrcode": "^1.5.4",
    "qs": "^6.16.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.2",
    "pinia": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.starwish.music",
    "productName": "星河音乐",
    "copyright": "Copyright © 2026 StarWish Music",
    "directories": {
      "output": "dist/release",
      "buildResources": "resources"
    },
    "asar": true,
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sql.js/dist/sql-wasm.js",
      "package.json",
      "!**/*.map",
      "!**/node_modules/@capacitor/**"
    ],
    "extraResources": [
      {
        "from": "sources",
        "to": "sources",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "星河音乐-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "星河音乐",
      "artifactName": "StarWish-${version}-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "星河音乐-${version}-便携版.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "artifactName": "StarWish-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "AudioVideo",
      "artifactName": "StarWish-${version}-linux-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mancking/StarWish-Music.git"
  },
  "homepage": "https://github.com/mancking/StarWish-Music#readme",
  "bugs": {
    "url": "https://github.com/mancking/StarWish-Music/issues"
  }
}
