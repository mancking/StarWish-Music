{
  "name": "starwish-music",
  "productName": "星河音乐",
  "version": "1.0.0",
  "description": "星河音乐 StarWish Music —— 多音源聚合桌面音乐播放器（Electron + Vue3 + TypeScript 新架构）",
  "main": "dist/electron/main.js",
  "author": {
    "name": "StarWish Music 开发组",
    "email": "starwish@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron && node scripts/copy-dev-sources.mjs",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.cjs --win portable nsis",
    "dist:release": "node scripts/release-build.mjs",
    "dist:android:release": "node scripts/release-android.mjs",
    "dist:portable": "npm run build && electron-builder --config electron-builder.cjs --win portable",
    "gate:zero-source": "node scripts/gate-zero-source.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:back-handler": "node --import ./scripts/test-hooks.mjs --experimental-strip-types scripts/test-back-handler.ts",
    "test:paths": "node scripts/paths-check.mjs",
    "test:playlists": "node scripts/playlists-check.mjs",
    "test:podcast": "node scripts/podcast-check.mjs",
    "test:order": "node scripts/pl-order-check.mjs",
    "test:pl-source": "node scripts/pl-source-check.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts && node scripts/copy-wasm.mjs && node scripts/rename-mobile-html.mjs",
    "mobile:sync": "npm run build:mobile && cap sync android",
    "dist:android": "npm run build:mobile && cap sync android && cd android && gradlew.bat assembleRelease assembleDebug",
    "mobile:smoke": "electron --no-sandbox scripts/mobile-smoke.mjs"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "axios": "^1.20.0",
    "big-integer": "^1.6.52",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.23",
    "he": "^2.0.0",
    "lamejs": "^1.2.1",
    "music-metadata": "^10.9.1",
    "qrcode": "^1.5.4",
    "qs": "^6.16.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.2",
    "pinia": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mancking/StarWish-Music.git"
  },
  "homepage": "https://github.com/mancking/StarWish-Music#readme",
  "bugs": {
    "url": "https://github.com/mancking/StarWish-Music/issues"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
